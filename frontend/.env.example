# Supabase project (Project Settings → API Keys). Both values are public by design;
# row-level security in supabase/schema.sql is what protects the data.
# Leave them unset to run in local mode (data stored in the browser only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Optional: social sign-in buttons, once enabled in Supabase → Authentication → Providers
VITE_AUTH_PROVIDERS=
