# CI-only signing helpers for the GitHub Actions iOS release (no Mac needed).
#
# `signing` creates a short-lived Apple Distribution certificate (private key
# stays in a temporary CI keychain) and a matching App Store provisioning
# profile. `revoke` deletes that certificate when the build is done, so runs
# never pile up against Apple's certificate limit. Builds already uploaded to
# App Store Connect are unaffected by the revocation.

default_platform(:ios)

APP_ID = 'com.praveendhra.momentum'
KEYCHAIN = 'momentum-ci.keychain-db'
KEYCHAIN_PASSWORD = 'momentum-ci'

def api_key!
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_filepath: ENV.fetch('ASC_KEY_PATH'),
  )
end

platform :ios do
  lane :signing do
    key = api_key!
    create_keychain(name: KEYCHAIN, password: KEYCHAIN_PASSWORD, default_keychain: true,
                    unlock: true, timeout: 3600, lock_when_sleeps: false)
    out = ENV.fetch('RUNNER_TEMP')
    get_certificates(api_key: key, development: false, generate_apple_certs: true,
                     keychain_path: File.expand_path("~/Library/Keychains/#{KEYCHAIN}"),
                     keychain_password: KEYCHAIN_PASSWORD, output_path: out)
    cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
    get_provisioning_profile(api_key: key, app_identifier: APP_ID, cert_id: cert_id, force: true,
                             output_path: out, filename: 'Momentum_AppStore.mobileprovision')
    File.open(ENV.fetch('GITHUB_ENV'), 'a') do |f|
      f.puts "CI_CERT_ID=#{cert_id}"
      f.puts "CI_PROFILE_UUID=#{lane_context[SharedValues::SIGH_UUID]}"
      f.puts "CI_PROFILE_NAME=#{lane_context[SharedValues::SIGH_NAME]}"
    end
  end

  lane :revoke do
    api_key!
    id = ENV['CI_CERT_ID'].to_s
    next if id.empty?
    cert = Spaceship::ConnectAPI::Certificate.all.find { |c| c.id == id }
    if cert
      cert.delete!
      UI.success("Revoked temporary certificate #{id}")
    end
  end
end

# ─── App Store listing ───
# Uploads fastlane/metadata + fastlane/screenshots via the App Store Connect
# API. Review contact + demo account come from repo secrets.
def review_info
  info = {
    first_name: 'Praveendhra',
    last_name: 'Rajkumar',
    email_address: 'momentum@mail.praveendhra.com',
    notes: "Sign in with the demo account below (it has sample data loaded), or use Sign in with Apple.\n" \
           "Account deletion: Settings → Danger zone → Delete account.\n" \
           "The app also works as a website at https://momentum.praveendhra.com with the same account.",
  }
  info[:phone_number] = ENV['REVIEW_PHONE'] unless ENV['REVIEW_PHONE'].to_s.empty?
  unless ENV['REVIEW_DEMO_EMAIL'].to_s.empty?
    info[:demo_user] = ENV['REVIEW_DEMO_EMAIL']
    info[:demo_password] = ENV['REVIEW_DEMO_PASSWORD']
  end
  info
end

platform :ios do
  lane :listing do |opts|
    submit = opts[:submit] == true || opts[:submit] == 'true'
    deliver(
      api_key: api_key!,
      app_identifier: APP_ID,
      app_version: ENV.fetch('APP_VERSION', '1.0.0'),
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true, # no HTML preview on CI
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      # Apple requires a contact phone for review details; skip them until REVIEW_PHONE is set.
      app_review_information: (ENV['REVIEW_PHONE'].to_s.empty? ? nil : review_info),
      submit_for_review: submit,
      automatic_release: true,
      build_number: (ENV['BUILD_NUMBER'] unless ENV['BUILD_NUMBER'].to_s.empty?),
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
    )
  end
end
